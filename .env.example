# Backend API base URL used by the browser. Leave as /api/v1 in dev; Vite proxies it to VITE_BACKEND_URL.
VITE_API_BASE_URL=/api/v1

# Laravel backend (titaniun_financial_backend) origin for the dev proxy.
VITE_BACKEND_URL=http://localhost:8000

# Contact details shown on the sign-in page ("Need help? Call … or email …").
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=

# ISO 4217 currency code for amounts (e.g. UGX). Leave empty to show plain numbers.
VITE_CURRENCY=
