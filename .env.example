# Browser API base URL. Vite proxies this locally; vercel.json proxies it on Vercel.
VITE_API_BASE_URL=/api/v1

# Laravel backend origin for the local dev proxy only. Vercel uses vercel.json.
VITE_BACKEND_URL=http://localhost:8000

# Contact details shown on the sign-in page ("Need help? Call … or email …").
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=

# ISO 4217 currency code for amounts (e.g. UGX). Leave empty to show plain numbers.
VITE_CURRENCY=
